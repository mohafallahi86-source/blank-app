const $ = (id) => document.getElementById(id);
const pct = (v, d = 2) => (v == null ? '—' : (v * 100).toFixed(d) + '%');
const int = (v) => (v == null ? '—' : v.toLocaleString('en'));
function formatPeriod(p) {
  const m = /^(\d{4})-(\d{2})$/.exec(p);
  return m ? new Date(Date.UTC(+m[1], +m[2] - 1, 1)).toLocaleString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : p;
}
// Change vs prior month: relative for counts, percentage points for rates
function deltaHtml(cur, prev, kind, goodWhenUp) {
  if (cur == null || prev == null) return '<span class="flat">no prior month</span>';
  const d = kind === 'count' ? (prev ? cur / prev - 1 : null) : (cur - prev) * 100;
  if (d == null) return '<span class="flat">no prior month</span>';
  const txt = kind === 'count' ? (d >= 0 ? '+' : '−') + Math.abs(d * 100).toFixed(1) + '%' : (d >= 0 ? '+' : '−') + Math.abs(d).toFixed(2) + ' pts';
  const cls = Math.abs(d) < 1e-9 || goodWhenUp == null ? 'flat' : (d > 0) === goodWhenUp ? 'up' : 'down';
  return `<span class="${cls}">${txt}</span> vs prior month`;
}

let DATA = null;            // { apps, months, products }
