// CSV of the band table for every month, with the current channel and product filters
function downloadTable() {
  const cols = ['month', 'channel', 'product', 'pd_band', 'applications', 'application_pct', 'rejects_pct_kor', 'rejects_pct_score',
    'high_side_overrides_pct', 'low_side_overrides_pct', 'approved_pct', 'booked_pct'];
  const out = [cols.join(',')];
  const f = (v) => (v == null ? '' : (v * 100).toFixed(4));
  const q = (s) => '"' + String(s).replace(/"/g, '""') + '"';
  for (const m of DATA.months) {
    const { rows, total } = bandTable(filtered(m));
    for (const r of [...rows, total]) {
      out.push([m, q(SEL.channel), q(SEL.product), q(r.band), r.a, f(r.appPct), f(r.korPct), f(r.scorePct), f(r.hsoPct), f(r.lsoPct), f(r.approvedPct), f(r.bookedPct)].join(','));
    }
  }
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['﻿' + out.join('\n')], { type: 'text/csv' }));
  a.download = 'pd_band_table.csv';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

/* ============================================================================
   7. STARTUP
   ========================================================================== */
document.title = CONFIG.title; $('title').textContent = CONFIG.title;

async function loadFile(file) {
  if (!file) return;
  const ext = (file.name.match(/\.([^.]+)$/) || [])[1]?.toLowerCase() || '';
  const previous = $('fileinfo').textContent;
  $('fileinfo').textContent = 'Reading ' + file.name + '…';
  try {
    if (ext === 'sas7bdat') throw new Error('SAS datasets (.sas7bdat) can’t be read in a browser. In SAS, export the data as CSV or Excel (see applications_export.sas) and load that file.');
    if (ext === 'xls') throw new Error('Old-style .xls files aren’t supported. Save the file as .xlsx or CSV and load it again.');
    const table = ext === 'xlsx' || ext === 'xlsm' ? await readXlsx(await file.arrayBuffer()) : parseCSV(await file.text());
    showData(toApplications(table), file.name);
  } catch (e) {
    showError(e);
    $('fileinfo').textContent = previous;
  }
}
$('file').addEventListener('change', (e) => { loadFile(e.target.files[0]); e.target.value = ''; });
$('f-month').addEventListener('change', (e) => { SEL.month = e.target.value; render(); });
$('f-channel').addEventListener('change', (e) => { SEL.channel = e.target.value; render(); });
$('f-product').addEventListener('change', (e) => { SEL.product = e.target.value; render(); });
$('download').addEventListener('click', downloadTable);
document.addEventListener('dragover', (e) => { e.preventDefault(); document.body.classList.add('dragging'); });
document.addEventListener('dragleave', (e) => { if (!e.relatedTarget) document.body.classList.remove('dragging'); });
document.addEventListener('drop', (e) => { e.preventDefault(); document.body.classList.remove('dragging'); loadFile(e.dataTransfer.files[0]); });
let _rt; window.addEventListener('resize', () => { clearTimeout(_rt); _rt = setTimeout(render, 150); });
</script>
